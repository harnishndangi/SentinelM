# SentinelML Centralized Environment Configuration

# Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
SECRET_KEY=sentinelml-default-secret-key-change-in-production-32bytes

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=SentinelML
HOST=0.0.0.0
PORT=8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Project Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection URL (Supabase PostgreSQL / Local Fallback)
# For Supabase Direct Connection:
# DATABASE_URL=postgresql://postgres:your-supabase-db-password@db.your-project-ref.supabase.co:5432/postgres
# For Supabase Connection Pooler (Transaction Mode, Port 6543):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-supabase-db-password@aws-0-region.pooler.supabase.com:6543/postgres
# Local SQLite Dev Fallback:
DATABASE_URL=sqlite:///./sentinelml.db

# Redis Configuration (Caching & Async Workers)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WS_REDIS_CHANNEL=sentinel_websocket_events


# ML Artifacts & Data Directories
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
EXPERIMENTS_DIR=./experiments

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
