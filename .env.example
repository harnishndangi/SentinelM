# SentinelML Centralized Environment Configuration

# Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars

# Backend API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=SentinelML
HOST=0.0.0.0
PORT=8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL / SQLite fallback for local dev)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelml_db
DATABASE_URL=sqlite:///./sentinelml.db

# Redis Configuration (Caching & Async Workers)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ML Artifacts & Data Directories
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
EXPERIMENTS_DIR=./experiments

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
